# Copy to .env (the installers generate it for you with random secrets). Never commit .env.

# --- app secrets --------------------------------------------------------------
CTE_SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL + pgvector (docker compose) ------------------------------------------
CTE_DB_USER=cte
CTE_DB_PASSWORD=change-me
CTE_DB_NAME=cte
CTE_DB_PORT=5440

# --- Redis (rate limits / pub-sub) ---------------------------------------------------
CTE_REDIS_PORT=6380

# --- AI gateway: your OpenAI-compatible AI server (see config.json -> app.ai_server_repo) ---
# Called with the official OpenAI Python SDK (base_url + api_key below).
CTE_GATEWAY_URL=http://127.0.0.1:4000/v1
CTE_GATEWAY_API_KEY=
CTE_GATEWAY_MODEL=gateway-default
CTE_GATEWAY_MAX_CONCURRENCY=4

# --- Qwen coder (always on the GPU, in Docker) -----------------------------------------
CTE_VLLM_API_KEY=change-me
CTE_CODER_URL=http://127.0.0.1:8011/v1
CTE_CODER_MODEL=qwen-coder
CTE_CODER_ENGINE=vLLM (Docker, GPU)
# vLLM (NVIDIA, or AMD on Linux with ROCm):
QWEN_CODER_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
CODER_MAX_MODEL_LEN=16384
CODER_GPU_UTIL=0.85
# llama.cpp (AMD / any GPU on Windows: Vulkan via Direct3D 12) - written by install.ps1 instead of the vLLM lines:
# COMPOSE_FILE=docker-compose.yml;docker/compose.llamacpp-dxg.yml
# COMPOSE_PROFILES=coder-llamacpp
# LLAMACPP_IMAGE=cte-llamacpp-dozen:latest
# QWEN_CODER_GGUF=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M
# CODER_PARALLEL=2
# CODER_GPU_LAYERS=99

# --- MiniCPM-V on vLLM (OCR fallback when no Windows OCR / Apple Vision) ---------------
CTE_VISION_URL=http://127.0.0.1:8012/v1
CTE_VISION_MODEL=minicpm-v
VISION_MODEL=openbmb/MiniCPM-V-2_6
VISION_GPU_UTIL=0.35

# Hugging Face token (only for gated models)
HF_TOKEN=

# --- docker compose selection (written by the installer for your GPU) -----------------
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker/compose.nvidia.yml
COMPOSE_PROFILES=coder
# AMD on Linux with vLLM: VLLM_ROCM_IMAGE=rocm/vllm:<gfx120X-all tag for RX 9000 cards>
# Models never run on the CPU: without a usable GPU the coder container is simply not started.
